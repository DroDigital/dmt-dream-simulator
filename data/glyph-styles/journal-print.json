{
  "name": "journal-print",
  "mode": "ascii",
  "font": "VT323",
  "ramp": " .:-=+*#%@",
  "cellPx": 7,
  "depthCells": false,
  "depthNear": 6,
  "depthFar": 40,
  "cellSizes": [
    12,
    8,
    6
  ],
